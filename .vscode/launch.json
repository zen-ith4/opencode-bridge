{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "OpenCode Bridge: Launch Extension",
      "type": "extensionHost",
      "request": "launch",
      "args": [
        "--extensionDevelopmentPath=${workspaceFolder}"
      ],
      "outFiles": [
        "${workspaceFolder}/out/**/*.js",
        "${workspaceFolder}/out/**/*.cjs"
      ],
      "preLaunchTask": "OpenCode Bridge: bundle",
      "sourceMaps": true
    }
  ]
}
